<html lang="en-AU"><head><meta charset="utf-8"/><meta content="width=device-width,initial-scale=1" name="viewport"/><title>EDWB550 Assessment 2 | Prasanna Sharma</title><style>*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:#253541;background:#faf9f6;font:17px/1.7 Georgia,serif}a{color:#1b6271;overflow-wrap:anywhere}header{background:#203746;color:#fff;padding:45px max(22px,calc((100% - 1040px)/2)) 38px}header h1{font:600 2.1rem/1.2 Georgia;margin:.5rem 0}header p{margin:.3rem 0;color:#e1e8e9}nav{background:#edf1f0;border-bottom:1px solid #d2dedd;position:sticky;top:0;z-index:10}nav div{max-width:1040px;margin:auto;display:flex;gap:20px;flex-wrap:wrap;padding:12px 20px}nav a{text-decoration:none;font:600 13px Arial;color:#244b55}main{max-width:1040px;margin:auto;padding:20px 25px 75px}section{padding:25px 0;border-bottom:1px solid #dce1df}h2{font:600 1.65rem Georgia;color:#243d4b}h3{font:600 1.2rem Georgia;color:#243d4b}p{margin:0 0 1.15em} .note{background:#f0f2ef;border-left:3px solid #64858b;padding:15px 20px;font:15px/1.6 Arial;margin:18px 0}.diagram{max-width:700px;margin:20px auto}.diagram svg{width:100%;height:auto}.slide{background:white;border:1px solid #d4dcdb;padding:30px;margin:18px 0;min-height:500px;box-shadow:0 3px 12px #1c344008}.slide h3{font-size:1.5rem}.slide-graphic{max-width:620px;margin:auto}.slide-graphic svg{width:100%;max-height:170px}.slide li{margin:9px 0}.slide-count{font:12px Arial;color:#61717a;letter-spacing:1px}.slide-controls{display:flex;gap:12px;margin:15px 0}button{border:1px solid #345c68;border-radius:4px;background:#345c68;color:white;padding:11px 20px;cursor:pointer;font:14px Arial}button:disabled{opacity:.4}.references li{margin:0 0 14px;padding-left:5px}.muted{font:14px/1.5 Arial;color:#52636d}@media(max-width:650px){header{padding:30px 22px}header h1{font-size:1.65rem}main{padding:10px 18px 55px}.slide{padding:18px;min-height:auto}.slide h3{font-size:1.25rem}nav div{gap:12px}body{font-size:16px}}@media print{nav,.slide-controls{display:none}.slide{break-inside:avoid;box-shadow:none}section{break-before:page}}
